# Copy this file to ".env" in this folder and fill it in.
DOMAIN=yourname.duckdns.org
CONTACT_EMAIL=
GOOGLE_CLIENT_ID=

# Forgot-password emails (leave empty to hide the "Forgot password?" link). With a Gmail account:
# SMTP_HOST=smtp.gmail.com, SMTP_USER=the Gmail address, SMTP_PASSWORD=a 16-letter Google "app password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
